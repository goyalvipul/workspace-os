{
  "name": "workspace-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @wos/server --filter @wos/web dev",
    "build": "pnpm --filter @wos/web build && pnpm --filter @wos/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "db:generate": "pnpm --filter @wos/server db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@axe-core/playwright": "^4.10.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.3.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}

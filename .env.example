# Workspace OS configuration. Copy to .env (or run `node scripts/gen-env.mjs`). Never commit .env.

NODE_ENV=production
LOG_LEVEL=info

# --- Network ---------------------------------------------------------------
# Container listens on APP_PORT; compose publishes it on 127.0.0.1:HOST_PUBLISHED_PORT only.
APP_PORT=3000
APP_HOST=0.0.0.0
HOST_PUBLISHED_PORT=4390
# The address you open in the browser (used for CSRF/origin checks, OAuth redirects, cookie Secure flag).
# With Tailscale Serve this is e.g. https://my-pc.tailnet-name.ts.net
PUBLIC_BASE_URL=http://localhost:4390
# Extra allowed origins, comma separated (e.g. a second tailnet name)
TRUSTED_ORIGINS=

# --- Storage ---------------------------------------------------------------
DATABASE_PATH=/data/workspace.sqlite
BACKUP_DIR=/backups

# --- Owner defaults --------------------------------------------------------
OWNER_TIMEZONE=America/Vancouver

# --- Secrets (generated by scripts/gen-env.mjs) ------------------------------
SESSION_SECRET=GENERATE_ME
DATA_ENCRYPTION_KEY=GENERATE_ME
DATA_ENCRYPTION_KEY_VERSION=1
# During key rotation, put the old key here; new writes use DATA_ENCRYPTION_KEY.
DATA_ENCRYPTION_KEY_PREVIOUS=

# --- Google Calendar (optional; see docs/PROVIDER_NOTES.md) -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4390/api/v1/calendar/oauth/google/callback

# --- Microsoft Outlook / 365 (optional) ---------------------------------------
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REDIRECT_URI=http://localhost:4390/api/v1/calendar/oauth/microsoft/callback

# --- Sync cadence (seconds) ---------------------------------------------------
ACTIVE_SYNC_SECONDS=60
IDLE_SYNC_SECONDS=300

# --- Backups ------------------------------------------------------------------
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=3

# --- Web Push (optional; generated by scripts/gen-env.mjs) ----------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=
